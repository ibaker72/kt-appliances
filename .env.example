###############################################################################
# KT Appliances — environment variables
#
# Copy to .env.local for development, or set these in your hosting provider.
# NEVER commit real values. Anything prefixed NEXT_PUBLIC_ is shipped to the
# browser — never put a secret behind that prefix.
#
# The site runs with none of these set (it falls back to sample inventory in
# development and honest empty states in production), so you can bring them
# online one group at a time.
###############################################################################

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph tags,
# sitemap entries and absolute links.
# IMPORTANT: while this is unset, robots.txt disallows all crawling — that is
# deliberate, so a preview deployment cannot get indexed before launch.
NEXT_PUBLIC_SITE_URL=https://ktappliances.com

# Digits only. Used to build tel: and sms: links and the LocalBusiness schema.
NEXT_PUBLIC_BUSINESS_PHONE=9735199717
NEXT_PUBLIC_BUSINESS_EMAIL=ktappliances20@gmail.com

# Optional social profiles. Rendered into `sameAs` on the LocalBusiness schema
# when present; omitted entirely when blank.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_MARKETPLACE_URL=

# -----------------------------------------------------------------------------
# Supabase — inventory, images and leads
# -----------------------------------------------------------------------------
# Without these the site shows empty states instead of products, the admin area
# reports "no database connected", and lead submissions are written to the
# server log rather than a table.
#
# Setup: create a project, run EVERY file in supabase/migrations/ in order
# (0001_init.sql then 0002_api_role_grants.sql — 0002 grants the API roles table
# access; without it Postgres answers "permission denied for table appliances"),
# then set:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY. Bypasses row-level security — required for all admin writes,
# image uploads and lead inserts. Must never be exposed to the browser.
# This must be the project's service-role secret, NOT the anon/publishable key.
# Pasting the anon key here makes every privileged query fail with
# "permission denied"; the admin detects that case and says so.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for appliance photography. Created by the migration.
SUPABASE_INVENTORY_BUCKET=appliance-images

# -----------------------------------------------------------------------------
# Admin access
# -----------------------------------------------------------------------------
# Both are required for anyone to sign in to /admin. With either missing, the
# admin area fails closed and the login page explains what to set.
ADMIN_PASSWORD=
# At least 16 characters. Generate one: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Email — lead notifications (Resend)
# -----------------------------------------------------------------------------
# Optional. Without a key, leads are still saved and the form still succeeds —
# only the notification email is skipped.
RESEND_API_KEY=
# Where the internal "new lead" alert goes. Defaults to the business email.
LEADS_NOTIFICATION_EMAIL=
# Must be an address on a domain verified in Resend.
LEADS_FROM_EMAIL=

# -----------------------------------------------------------------------------
# SMS — implemented, gated off
# -----------------------------------------------------------------------------
# The Twilio transport is real (src/lib/sms/client.ts, the REST API over fetch —
# no SDK dependency). What keeps it quiet is this one flag.
#
# THE A2P GATE
# The A2P 10DLC brand is approved; the campaign is still under carrier review.
# While SMS_SENDING_ENABLED is anything other than "true", every outbound
# message — customer confirmations and internal owner alerts alike — is skipped
# and logged. Appointments still save, the booking form still succeeds, and the
# confirmation screen correctly does not claim a text was sent.
#
# AFTER THE CAMPAIGN IS APPROVED, THIS IS THE ONE VARIABLE TO CHANGE:
SMS_SENDING_ENABLED=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Strongly preferred over TWILIO_FROM_NUMBER: the Messaging Service is what
# carries the A2P campaign registration, the sender pool, and Twilio's Advanced
# Opt-Out handling for STOP/HELP replies. When both are set this one wins.
# KT Appliances' service SID is MG1798bb161454e4dbf4178ed4f1012826.
TWILIO_MESSAGING_SERVICE_SID=

# Fallback single sender. Sending from a bare number bypasses the campaign
# registration, so leave this blank once the Messaging Service SID is set.
TWILIO_FROM_NUMBER=

# Optional second valve, for the awkward middle state only. Leave it unset and
# customer texts simply follow SMS_SENDING_ENABLED above — which is what makes
# go-live a one-variable change. Set it to "false" to keep customer-facing A2P
# traffic off while still letting internal owner alerts through.
SMS_CUSTOMER_SENDING_ENABLED=true

# -----------------------------------------------------------------------------
# Appointment alerts
# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY. Where the "new appointment" text goes when someone books at
# /schedule. E.164, e.g. +19735551234.
#
# This is the owner's handset, not the published business line, so it has no
# default — an unset value means the owner alert is skipped and logged, and the
# booking still succeeds. Deliberately never exposed to the browser.
APPOINTMENT_NOTIFICATION_PHONE=

# -----------------------------------------------------------------------------
# Analytics & advertising
# -----------------------------------------------------------------------------
# Each script loads only when its ID is present, and only once.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads conversion tracking. The label is only used for the conversion
# event, so no phantom conversions are reported while it is blank.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Search Console HTML tag verification (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Maps
# -----------------------------------------------------------------------------
# Optional. Without a key the contact page falls back to the keyless Google Maps
# embed, which works fine — it just has fewer options.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Sample inventory
# -----------------------------------------------------------------------------
# Sample data is served automatically in development when Supabase is not
# configured. Set this to true to also serve it from a production build — useful
# for a client review deployment. A prominent banner marks the site as sample
# data whenever it is active. Leave blank for real deployments.
NEXT_PUBLIC_ENABLE_DEMO_INVENTORY=
