###############################################################################
# KT Appliances — environment variables
#
# Copy to .env.local for development, or set these in your hosting provider.
# NEVER commit real values. Anything prefixed NEXT_PUBLIC_ is shipped to the
# browser — never put a secret behind that prefix.
#
# The site runs with none of these set (it falls back to sample inventory in
# development and honest empty states in production), so you can bring them
# online one group at a time.
###############################################################################

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph tags,
# sitemap entries, JSON-LD @id values, llms.txt and IndexNow submissions.
#
# THE PRODUCTION VALUE IS THE HYPHENATED DOMAIN. Setting the wrong one does not
# fail loudly — every page just canonicalises to a host Google cannot reach.
#
# IMPORTANT: while this is unset, robots.txt disallows all crawling — that is
# deliberate, so a preview deployment cannot get indexed before launch. The daily
# SEO health check treats an unset or non-https value as a hard failure.
NEXT_PUBLIC_SITE_URL=https://kt-appliances.com

# THE PUBLIC BUSINESS LINE — the number customers call, text and see everywhere
# on the site: header, footer, mobile call bar, contact and schedule pages,
# `tel:` links, and the `telephone` on the LocalBusiness schema.
#
# This is NOT the Twilio sending number. Automated texts go out from
# TWILIO_FROM_NUMBER below and reach the customer from that number; this is the
# line the customer is invited to ring. Keep them distinct — the published NAP
# phone is what Google matches against the business listing.
#
# Any US format is accepted (+19735199717, 9735199717, (973) 519-9717); it is
# normalised to ten digits and re-formatted for display as (973) 519-9717.
NEXT_PUBLIC_BUSINESS_PHONE=+19735199717
NEXT_PUBLIC_BUSINESS_EMAIL=ktappliances20@gmail.com

# Optional social profiles. Rendered into `sameAs` on the LocalBusiness schema
# when present; omitted entirely when blank.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_MARKETPLACE_URL=

# -----------------------------------------------------------------------------
# Supabase — inventory, images and leads
# -----------------------------------------------------------------------------
# Without these the site shows empty states instead of products, the admin area
# reports "no database connected", and lead submissions are written to the
# server log rather than a table.
#
# Setup: create a project, run EVERY file in supabase/migrations/ in order
# (0001_init.sql then 0002_api_role_grants.sql — 0002 grants the API roles table
# access; without it Postgres answers "permission denied for table appliances" —
# then 0003_appointments.sql and 0004_seo_url_submissions.sql), then set:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY. Bypasses row-level security — required for all admin writes,
# image uploads and lead inserts. Must never be exposed to the browser.
# This must be the project's service-role secret, NOT the anon/publishable key.
# Pasting the anon key here makes every privileged query fail with
# "permission denied"; the admin detects that case and says so.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for appliance photography. Created by the migration.
SUPABASE_INVENTORY_BUCKET=appliance-images

# -----------------------------------------------------------------------------
# Admin access
# -----------------------------------------------------------------------------
# Both are required for anyone to sign in to /admin. With either missing, the
# admin area fails closed and the login page explains what to set.
ADMIN_PASSWORD=
# At least 16 characters. Generate one: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Email — lead notifications (Resend)
# -----------------------------------------------------------------------------
# Optional. Without a key, leads are still saved and the form still succeeds —
# only the notification email is skipped.
RESEND_API_KEY=
# Where the internal "new lead" alert goes. Defaults to the business email.
LEADS_NOTIFICATION_EMAIL=
# Must be an address on a domain VERIFIED IN RESEND. Resend rejects any other
# sender, and it reports the rejection in the response body rather than by
# failing loudly — so an unverified domain here looks like a working form with
# an inbox that never fills up.
#
# Left blank, sending falls back to onboarding@resend.dev, which Resend accepts
# without a verified domain but will only deliver to the Resend account owner's
# own address. Good enough to prove the pipeline works; verify the real domain
# before advertising.
LEADS_FROM_EMAIL=

# -----------------------------------------------------------------------------
# SMS — implemented, gated off
# -----------------------------------------------------------------------------
# The Twilio transport is real (src/lib/sms/client.ts, the REST API over fetch —
# no SDK dependency). What keeps it quiet is this one flag.
#
# THE A2P GATE
# The A2P 10DLC brand is approved; the campaign is still under carrier review.
# While SMS_SENDING_ENABLED is anything other than "true", every outbound
# message — customer confirmations and internal owner alerts alike — is skipped
# and logged. Appointments still save, the booking form still succeeds, and the
# confirmation screen correctly does not claim a text was sent.
#
# AFTER THE CAMPAIGN IS APPROVED, THIS IS THE ONE VARIABLE TO CHANGE:
SMS_SENDING_ENABLED=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Strongly preferred over TWILIO_FROM_NUMBER: the Messaging Service is what
# carries the A2P campaign registration, the sender pool, and Twilio's Advanced
# Opt-Out handling for STOP/HELP replies. When both are set this one wins.
# KT Appliances' service SID is MG1798bb161454e4dbf4178ed4f1012826.
TWILIO_MESSAGING_SERVICE_SID=

# THE TWILIO SENDING NUMBER — KT Appliances' Twilio-owned number, (570) 750-0622.
#
# Used as the direct `From` only when no Messaging Service SID is set above.
# With the SID present this is not sent to Twilio at all: the Messaging Service
# picks the sender from its registered pool, which is how the A2P campaign stays
# attached. Recorded here regardless so the owned number is documented in one
# place and the admin can show which number customers receive texts from.
#
# Never put the public business line here. Twilio may only send from a number
# the account owns or has hosted/verified, and publishing texts from the shop's
# call-in line would misrepresent the sender to the carriers.
TWILIO_FROM_NUMBER=+15707500622

# Optional second valve, for the awkward middle state only. Leave it unset and
# customer texts simply follow SMS_SENDING_ENABLED above — which is what makes
# go-live a one-variable change. Set it to "false" to keep customer-facing A2P
# traffic off while still letting internal owner alerts through.
SMS_CUSTOMER_SENDING_ENABLED=true

# -----------------------------------------------------------------------------
# Appointment alerts
# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY. Where the "new appointment" text goes when someone books at
# /schedule. E.164. Never exposed to the browser, and the admin renders it
# masked — (***) ***-9717 — so a shoulder-surfed screen does not leak it.
#
# Set to the main business line by decision: the owner reads bookings on the
# number the shop already runs on, rather than a second private handset.
#
# ONE PRECONDITION, WHICH THIS REPOSITORY CANNOT CHECK:
# +19735199717 must be able to RECEIVE SMS. Owner alerts are delivered by Twilio
# like any other message, so if this line is a landline or a VoIP number without
# SMS, Twilio returns error 21614 ("not a mobile number") or 30006 (landline /
# unreachable) and every alert lands in the notification ledger as `failed`.
# Bookings still save and the customer still gets their confirmation — only the
# owner's copy is lost, silently apart from the log line.
#
# Verify by texting +19735199717 from a handset before treating owner alerts as
# operational. If it cannot receive SMS, put the owner's mobile here instead —
# this variable is the alert destination, and it is independent of
# NEXT_PUBLIC_BUSINESS_PHONE, which stays +19735199717 either way.
APPOINTMENT_NOTIFICATION_PHONE=+19735199717

# -----------------------------------------------------------------------------
# Analytics & advertising
# -----------------------------------------------------------------------------
# Each script loads only when its ID is present, and only once.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads conversion tracking. The label is only used for the conversion
# event, so no phantom conversions are reported while it is blank.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Search Console HTML tag verification — the content value only, not the whole
# <meta> tag. Rendered by rootMetadata.verification.google.
#
# Not needed if you verify the domain by DNS, which is the better option: it
# covers every subdomain and survives a redeploy.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Scheduled jobs
# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY — never prefix this NEXT_PUBLIC_.
#
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` on every scheduled
# invocation, and that header is the only credential the cron routes accept (a
# secret in a querystring ends up in access logs and referrers).
#
# THE ROUTES FAIL CLOSED. While this is unset, /api/cron/seo-health and
# /api/cron/search-indexing answer 503 and do nothing — a forgotten variable is a
# loud entry in the cron log rather than a quietly public endpoint.
#
# Generate one: openssl rand -base64 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# IndexNow — optional
# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY. Notifies Bing, Yandex, Seznam and Naver when a page's content
# genuinely changes. GOOGLE DOES NOT USE INDEXNOW — nothing here affects Google
# Search, which is served by the sitemap, honest lastmod values, internal linking
# and Search Console.
#
# 8-128 characters, letters/digits/hyphens. Generate one: openssl rand -hex 16
#
# Once set, the key is served publicly at /indexnow-key.txt. That is required by
# the protocol as the ownership proof — the only thing it authorises is notifying
# search engines about pages on this domain — but it stays server-side because
# there is no reason to ship it in a JavaScript bundle.
#
# Leave blank and /api/cron/search-indexing reports `configured: false` and sends
# nothing. It also needs SUPABASE_SERVICE_ROLE_KEY above and the
# supabase/migrations/0004_seo_url_submissions.sql table: without the submission
# ledger there is no way to know what was already announced, so it refuses to
# submit rather than resubmit the same URLs on every run.
INDEXNOW_KEY=

# -----------------------------------------------------------------------------
# Maps
# -----------------------------------------------------------------------------
# Optional. Without a key the contact page falls back to the keyless Google Maps
# embed, which works fine — it just has fewer options.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Sample inventory
# -----------------------------------------------------------------------------
# Sample data is served automatically in development when Supabase is not
# configured. Set this to true to also serve it from a production build — useful
# for a client review deployment. A prominent banner marks the site as sample
# data whenever it is active. Leave blank for real deployments.
NEXT_PUBLIC_ENABLE_DEMO_INVENTORY=
